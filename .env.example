# ─── StudentAI Environment Variables ───────────────────────────────
# Copy to .env and fill in real values. NEVER commit real secrets.

# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Telegram Bot (from @BotFather). Without it, the web simulator still works.
TELEGRAM_BOT_TOKEN=
# Bot username without @ — used to build referral links
TELEGRAM_BOT_USERNAME=
# Random string; Telegram sends it back in the webhook header for verification
TELEGRAM_WEBHOOK_SECRET=

# AI provider (OpenAI-compatible). Without a key, MockProvider is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Web admin panel password (fallback if unset: studentai-admin)
ADMIN_PASSWORD=

# Environment & logging
NODE_ENV=development
